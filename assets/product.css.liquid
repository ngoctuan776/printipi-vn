/* Custom photoswipe thumbs */
.pswp__scroll-wrap .pswp__item img {
  background: #000;
  object-fit: contain;
  padding-bottom: 70px;
}
.pswp-thumbs {
  background: #000;
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 70px;
  padding-top: 10px;
  z-index: 10000;
  pointer-events: auto;
}
.pswp-thumbs .swiper-wrapper {
  justify-content: center;
}
.pswp__scroll-wrap .pswp__counter {
  left: 20px;
  margin: 0;
  top: 10px;
  min-width: 10px;
  padding: 0;
  background: transparent;
  color: #FFF;
}
.pswp__scroll-wrap .pswp__button--arrow {
  top: 45%;
  bottom: auto;
  margin: 0;
  padding: 0;
  min-width: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF;
  border-radius: 100%;
  width: 30px;
  height: 30px;
}
.pswp__scroll-wrap .pswp__button--arrow--prev {
  left: 20px;
}
.pswp__scroll-wrap .pswp__button--arrow--next {
  right: 20px;
  left: auto;
}
.pswp__scroll-wrap .pswp__button--arrow .pswp__icn {
  fill: #FFF;
}
.pswp-thumbs .swiper {
  height: 100%;
}
.pswp-thumbs .swiper-slide {
  width: 60px;
  height: 60px;
  opacity: 0.5;
  cursor: pointer;
}
.pswp-thumbs .swiper-slide-thumb-active {
  opacity: 1;
  outline: 2px solid #fff;
}
.pswp-thumbs img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Tee form */
div.tee-dialog, div.tee-form-wrapper, div.tee-gallery,
.teeinblue-theme-modern .tee-dialog, .teeinblue-theme-modern .tee-form-wrapper {
  --tee-primary-lighten-color: var(--color-main);
  --tee-preview-button-text-color: var(--color-main);
  --tee-form-header-color: var(--color-main-text);
  --tee-font-size: 12px;
  --tee-field-heading-font-size: 12px;
  --tee-field-select-color: var(--color-main-text);
  --tee-customize-main-form-border-color: #DDDDDD;
  --tee-form-input-height: 40px;
  --tee-atc-border-radius: 0;
  --tee-clipart-border-radius: 0;
  --tee-form-input-border-radius: 0;
  --tee-clipart-active-border-width: 1px;
  --tee-input-active-border-width: 1px;
  --tee-field-select-focus-border-width: 1px;
  --tee-form-input-color: var(--color-main-text);
  --tee-filed-select-focus-padding: 7px 35px 7px 15px;
}
@media only screen and (min-width:769px){
  div.tee-dialog, div.tee-form-wrapper, div.tee-gallery,
  .teeinblue-theme-modern .tee-dialog, .teeinblue-theme-modern .tee-form-wrapper {
    --tee-form-input-height: 44px;
  }
}

.teeinblue-theme-modern .tee-customize-main-form {border: none;margin-bottom: 20px;padding: 20px 15px;border-radius: 0;}
.tee-form-header {background-color: transparent;padding: 0 0 15px 0;text-align: left;font-size: 14px;text-transform: none;font-weight: 500;}
.tee-form-inputs {padding: 0;}
.tee-field__heading {font-weight: 500 !important;}
.tee__input {border: none;}
.tee-field__select:focus-visible,
.tee__input:focus-visible {box-shadow: none;}
.tee-btn, .tee-song__btn {font-weight: 500;}
.tee-clipart-row {
  margin: 0;
  width: 100%;
  gap: 10px;
}
.tee-field, .tee-form-group-fields {margin-bottom: 20px;}
.tee-clipart-col {
  padding: 0;
  flex: 0 0 auto;
  max-width: none;  
  min-width: 60px;
}
.tee-clipart {border: none;border-radius: 4px;}
.teeinblue-theme-modern .tee-clipart-checkmark {
  border: none;
  width: 11px;
  height: 11px;
  top: auto;
  bottom: 4px;
  right: 4px;
}

.tee-field.tee-field--text {
  display: flex;
}
.tee-field {display: flex;flex-wrap: wrap;}
.tee-field > div {width: 100%;}
.tee-field .tee-field__input {flex: 1;}
.tee-field .tee-field__input + .tee-field__subfield {
  flex: 0 0 44px; 
  padding-left: 10px;
  width: auto;
  margin-top: 0;
  box-sizing: content-box;
}
.tee-field .tee-field__input + .tee-field__subfield .tee-field__header {display: none;}
.tee-colorpicker-handle {border-radius: 0;box-shadow: none;width: 40px;height: 40px;}
.tee-colorpicker-body {left: auto;right: 0;}
.tee-switch__input {padding-top: 10px;padding-bottom: 10px;}
.teeinblue-theme-modern .tee-thumbnails__button {display: none;}
.tee-btn--preview {
  height: 46px;
  background: transparent;
  color: #000;
  border-color: #000;
}
.tee-btn--preview:hover {
  background: #000000;
  color: #FFFFFF;
}
.tee-campaign-form-footer .tee-block {
  margin-bottom: 10px;
}
.teeinblue-theme-modern .tee-slider__button {
  display: none;
}

.tee-thumbnails {
  width: 100% !important;
  margin-top: 20px;
  overflow-x: auto;
}
.tee-thumbnails__track {
  transform: none !important;
  width: fit-content;
  margin: 0 auto;
  gap: 8px;
}

.tee-thumbnails .tee-thumbnail,
.tee-thumbnails .tee-platform-mockup .tee-mockup,
.tee-thumbnails .tee-printarea--image {
  width: 80px !important;
  height: 80px !important;
  border-radius: 4px;
}
.tee-thumbnails .tee-thumbnail {
  margin: 0;
}

@media only screen and (min-width:769px){
  .tee-btn-wrapper--personalize {
    /* width: calc(100vw - var(--sidebar-width));
    left: auto;
    right: 0; */
    display: none;
  }
  .tee-thumbnails {
    scrollbar-width: thin; /* auto | thin | none */
    scrollbar-color: #999 transparent;
  }

  /* Chrome, Edge, Safari */
  .tee-thumbnails::-webkit-scrollbar {
    height: 8px; /* ngang */
    width: 8px;  /* dọc */
  }

  .tee-thumbnails::-webkit-scrollbar-track {
    background: transparent;
  }

  .scroll::-webkit-scrollbar-thumb {
    background-color: #999;
    border-radius: 999px;
  }

  .scroll::-webkit-scrollbar-thumb:hover {
    background-color: #666;
  }
  .tee-thumbnails .tee-thumbnail,
  .tee-thumbnails .tee-platform-mockup .tee-mockup,
  .tee-thumbnails .tee-printarea--image {
    width: 100px !important;
    height: 100px !important;
  }
  .tee-colorpicker-handle {width: 44px;height: 44px;}
}

@media only screen and (max-width:768px) {
  .pswp__top-bar .pswp__button--close {
    top: 10px;
